{
  "name": "entre-nosotros",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "pnpm questions:check && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "questions:generate": "node scripts/generate-questions.mjs",
    "questions:check": "node scripts/generate-questions.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:catalog:check": "node scripts/generate-database-catalog.mjs",
    "db:test": "pnpm dlx supabase@3.0.0 test db",
    "db:test:rpc": "node scripts/test-database-rpc.mjs"
  },
  "dependencies": {
    "lucide-react": "1.63.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vitest": "5.0.5",
    "prettier": "^3.6.2"
  }
}
